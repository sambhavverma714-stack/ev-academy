# Copy this file to backend/.env for local use. Replace placeholder values as needed.
# Never commit real keys or secrets.

PORT=5050
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database (optional locally): MongoDB server or MongoDB Atlas.
# Without it, development data is stored in backend/data/db.json.
# MONGODB_URI=mongodb://localhost:27017/ev-academy
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ev-academy

# Auth/certificate secrets (optional; app can generate/store them depending on setup)
# JWT_SECRET=replace-with-a-long-random-secret
# CERT_SECRET=replace-with-a-long-random-secret

# Admin bootstrap (used on first run)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-password

# Payments (Razorpay). Without these, payments run in demo mode.
# RAZORPAY_KEY_ID=rzp_test_placeholder
# RAZORPAY_KEY_SECRET=placeholder_secret

# Email verification (Resend)
# Set to true once a Resend domain is verified.
EMAIL_VERIFICATION_ENABLED=false
RESEND_API_KEY=re_placeholder_api_key
MAIL_FROM_EMAIL=onboarding@resend.dev
MAIL_FROM_NAME=EV Academy

# Optional: contact form destination
# CONTACT_EMAIL=team@example.com
